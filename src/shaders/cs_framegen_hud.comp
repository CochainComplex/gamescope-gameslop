#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#include "descriptor_set_constants.h"

layout(
  local_size_x = 8,
  local_size_y = 8,
  local_size_z = 1) in;

layout(binding = 0, scalar)
uniform framegen_hud_t {
    uint u_lineCount;
    uint u_widthChars;
    uint u_hdr;
    uint u_reserved;
    uint u_lineLengths[7];
    uint u_text[126];
    uint u_font[256];
};

layout(push_constant, scalar)
uniform framegen_hud_params_t {
    uint u_offsetX;
    uint u_offsetY;
    uint u_scale;
    uint u_pushReserved;
};

layout(binding = 1) writeonly uniform image2D dst;
layout(binding = 3) uniform sampler2D s_samplers[VKR_SAMPLER_SLOTS];

const uint kPadding = 4u;

uint text_byte(uint line, uint column) {
    uint byteIndex = line * 72u + column;
    uint word = u_text[byteIndex >> 2u];
    return bitfieldExtract(word, int((byteIndex & 3u) * 8u), 8);
}

bool glyph_pixel(uint glyph, uvec2 pixel) {
    // font8x8_basic stores its source rows bottom-to-top. Each uint contains
    // four rows, with the first source row in its least-significant byte.
    uint sourceRow = 7u - pixel.y;
    uint word = u_font[glyph * 2u + (sourceRow >> 2u)];
    uint rowBits = bitfieldExtract(word, int((sourceRow & 3u) * 8u), 8);
    return ((rowBits >> pixel.x) & 1u) != 0u;
}

vec3 srgb_decode(vec3 x) {
    return mix(x / 12.92, pow((max(x, vec3(0.0)) + 0.055) / 1.055, vec3(2.4)),
        greaterThan(x, vec3(0.04045)));
}
vec3 srgb_encode(vec3 x) {
    x = max(x, vec3(0.0));
    return mix(12.92 * x, 1.055 * pow(x, vec3(1.0 / 2.4)) - 0.055,
        greaterThan(x, vec3(0.0031308)));
}
vec3 pq_decode(vec3 x) {
    vec3 p = pow(max(x, vec3(0.0)), vec3(1.0 / 78.84375));
    return pow(max(p - 0.8359375, vec3(0.0)) /
        max(vec3(18.8515625) - 18.6875 * p, vec3(1e-6)), vec3(1.0 / 0.1593017578125));
}
vec3 pq_encode(vec3 x) {
    vec3 p = pow(max(x, vec3(0.0)), vec3(0.1593017578125));
    return pow((0.8359375 + 18.8515625 * p) / (1.0 + 18.6875 * p), vec3(78.84375));
}
vec3 palette(vec3 srgb) {
    vec3 linear = srgb_decode(srgb);
    if (u_hdr == 0u) return linear;
    // Rec.709 -> Rec.2020, at 160 nit reference white in PQ's 10000-nit units.
    return mat3(0.627404, 0.069097, 0.016391,
                0.329283, 0.919540, 0.088013,
                0.043313, 0.011362, 0.895595) * linear * 0.016;
}

void main() {
    uvec2 local = gl_GlobalInvocationID.xy;
    uvec2 logicalBlockSize = uvec2(u_widthChars * 8u, u_lineCount * 8u)
        + uvec2(kPadding * 2u);
    uvec2 blockSize = logicalBlockSize * u_scale;
    if (local.x >= blockSize.x || local.y >= blockSize.y)
        return;

    uvec2 coord = local + uvec2(u_offsetX, u_offsetY);
    uvec2 outSize = imageSize(dst);
    if (coord.x >= outSize.x || coord.y >= outSize.y)
        return;

    // The target is rebound through its raw sampled view. Reading and writing
    // the same unique pixel lets this single pass provide real alpha blending
    // without requiring shaderStorageImageReadWithoutFormat.
    vec4 base = texelFetch(s_samplers[0], ivec2(coord), 0);
    vec3 linearBase = u_hdr != 0u ? pq_decode(base.rgb) : srgb_decode(base.rgb);
    vec3 result = mix(linearBase, palette(vec3(0.065, 0.050, 0.105)), 0.14);

    // Spark bars are ordinary font glyphs, so text and history share this path.
    uvec2 logical = local / u_scale;
    // Thin, quiet accents share the menu palette without its large title art.
    if (logical.y == 0u)
        result = mix(result, palette(vec3(0.50, 0.88, 0.90)), 0.48);
    if (logical.x == 0u && logical.y > 0u)
        result = mix(result, palette(vec3(0.88, 0.40, 0.72)), 0.38);
    bool ink = false;
    if (logical.x >= kPadding && logical.y >= kPadding) {
        uvec2 textPixel = logical - uvec2(kPadding);
        uint line = textPixel.y >> 3u;
        uint column = textPixel.x >> 3u;
        if (line < u_lineCount && column < u_lineLengths[line]) {
            uint glyph = min(text_byte(line, column), 127u);
            ink = glyph_pixel(glyph, textPixel & 7u);
        }
    }

    if (ink) {
        vec3 color = logical.y < kPadding + 8u
            ? vec3(0.63, 0.86, 0.88) : vec3(0.75, 0.71, 0.81);
        result = mix(result, palette(color), 0.86);
    }

    result = u_hdr != 0u ? pq_encode(result) : srgb_encode(result);
    imageStore(dst, ivec2(coord), vec4(result, base.a));
}
