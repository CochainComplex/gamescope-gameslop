#version 450
#extension GL_GOOGLE_include_directive : require
#include "framegen/training_report.h"

// Owner-transaction fixture only; this deliberately does not implement Adam.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Input { float inputValues[]; };
layout(std430, binding = 1) readonly buffer Gradients { float gradients[]; };
layout(std430, binding = 2) buffer State { uint stateWords[]; };
layout(push_constant) uniform OptPush {
    float lr, ema, decay;
    uint step;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= GSC_REPORT_PARAMETERS) return;
    for (uint row = 0u; row < 5u; ++row) {
        uint at = row * GSC_REPORT_PARAMETERS + i;
        float accepted = uintBitsToFloat(stateWords[GSC_REPORT_BACKUP_OFFSET + at]);
        // Exact powers of two make the expected transaction bytes independent
        // of transcendental/reduction differences in real training arithmetic.
        float delta = float(p.step + row + 1u) * (1.0 / 1024.0);
        stateWords[at] = floatBitsToUint(accepted + delta);
    }
    if (inputValues[0] > 0.5 && i == GSC_REPORT_PARAMETERS - 1u)
        stateWords[2u * GSC_REPORT_PARAMETERS + i] = 0x7fc00001u;
}
