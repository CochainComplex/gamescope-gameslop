#version 450

layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Previous { vec4 previous[]; };
layout(std430, binding = 1) readonly buffer Current { vec4 current[]; };
layout(std430, binding = 2) writeonly buffer Output { vec4 outputPixels[]; };
layout(push_constant) uniform Params {
    uint width;
    uint height;
    uint method;
    float phase;
    float dx;
    float dy;
} p;

uint address(ivec2 pos) {
    pos = clamp(pos, ivec2(0), ivec2(p.width, p.height) - 1);
    return uint(pos.y) * p.width + uint(pos.x);
}

vec4 samplePrevious(vec2 pos) {
    pos = clamp(pos, vec2(0), vec2(p.width - 1, p.height - 1));
    ivec2 a = ivec2(floor(pos));
    vec2 f = fract(pos);
    return mix(mix(previous[address(a)], previous[address(a + ivec2(1, 0))], f.x),
               mix(previous[address(a + ivec2(0, 1))], previous[address(a + 1)], f.x), f.y);
}

vec4 sampleCurrent(vec2 pos) {
    pos = clamp(pos, vec2(0), vec2(p.width - 1, p.height - 1));
    ivec2 a = ivec2(floor(pos));
    vec2 f = fract(pos);
    return mix(mix(current[address(a)], current[address(a + ivec2(1, 0))], f.x),
               mix(current[address(a + ivec2(0, 1))], current[address(a + 1)], f.x), f.y);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.width * p.height) return;
    if (p.method == 0) {
        outputPixels[i] = mix(previous[i], current[i], p.phase);
    } else {
        // Analytic, constant previous-to-current displacement in full pixels.
        // This tests the engine contract; it estimates no motion or depth.
        vec2 pos = vec2(i % p.width, i / p.width);
        vec2 motion = vec2(p.dx, p.dy);
        outputPixels[i] = mix(samplePrevious(pos - p.phase * motion),
                              sampleCurrent(pos + (1.0 - p.phase) * motion), p.phase);
    }
}
