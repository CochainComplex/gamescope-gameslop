GSC_PROFILE(generation, GSC_OP_GENERATION, GSC_EXEC_ASYNC, GSC_PAYLOAD_PAIR, 0, GSC_SEM_RGBA_PAIR, GSC_STATE_NONE, GSC_TRANSPORT_HOST, GSC_FEATURE_DISCARD_RESULT|GSC_FEATURE_EXACT_DEVICE, 1)
GSC_PROFILE(snapshot_training, GSC_OP_TRAINING, GSC_EXEC_ASYNC, GSC_PAYLOAD_SNAPSHOT_TRAINING, 3, GSC_SEM_ONLINE_TENSORS, GSC_STATE_CALLER_CANDIDATE, GSC_TRANSPORT_HOST, GSC_FEATURE_FULL_DIAGNOSTICS|GSC_FEATURE_DISCARD_RESULT|GSC_FEATURE_EXACT_DEVICE, 1)
